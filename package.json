{
  "name": "digifall",
  "version": "0.16.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "stylelint-config-idiomatic-order": {
      "stylelint-order": "8.1.1"
    }
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "relay": "node nodes/relay/relay.mjs",
    "leaderboard": "node nodes/leaderboard/leaderboard.mjs",
    "validate-records": "node scripts/validate-records.mjs",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "test:browser": "node test/energy.browser.mjs",
    "check:domains": "bash .agents/skills/domain-dag/scripts/validate-domain-dag.sh --root .",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "lint": "stylelint 'src/**/*.{css,svelte}' '*.html' 'public/**/*.html' --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "autoprefixer": "10.5.5",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "postcss-nested": "7.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.15.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "14.1.2",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/bootstrap": "12.0.32",
    "@libp2p/circuit-relay-v2": "4.2.13",
    "@libp2p/config": "1.1.37",
    "@libp2p/floodsub": "11.0.30",
    "@libp2p/identify": "4.1.14",
    "@libp2p/interface": "3.3.0",
    "@libp2p/keychain": "6.1.7",
    "@libp2p/plaintext": "3.0.28",
    "@libp2p/pubsub-peer-discovery": "12.0.0",
    "@libp2p/websockets": "10.1.21",
    "@multiformats/multiaddr": "13.0.3",
    "datastore-fs": "12.0.1",
    "datastore-idb": "5.0.1",
    "howler": "2.2.4",
    "libp2p": "3.3.11",
    "uint8arrays": "6.1.1"
  }
}
